# Whether dependency versions saved to package.json use exact versions or ranges.
save-exact=true

# Whether to display funding information after installations.
fund=false

# Whether to display progress indicators during operations.
progress=true

# Default value of the private field for packages created with npm init.
init-private=true

# Minimum package publication age, in days, for dependency resolution.
min-release-age=3

# Whether unapproved dependency install scripts cause installation failure.
strict-allow-scripts=true

# Controls which local tarball dependencies are permitted.
allow-file=root

# Controls which local directory dependencies are permitted.
allow-directory=root

# Whether invalid or unrecognized npm configuration causes an error.
strict-npmrc=true

# Whether declared Node.js/npm engine incompatibilities prevent installation.
engine-strict=true

# Whether peer dependency conflicts that npm could otherwise resolve cause failure.
strict-peer-deps=true
